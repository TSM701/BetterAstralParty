<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DefineConstants>$(DefineConstants);BAP_SAFETY_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FrameworkParity.cs;MetadataPlugin.cs" />
    <Compile Include="../../tools/NativeReinstallGeneration.cs" />
    <Compile Include="../../updater/*.cs" Exclude="../../updater/UpdateHelperProgram.cs" />
    <Compile Remove="../../updater/ProductionUpdateKeys.cs" Condition="'$(FixtureTrustSource)' != ''" />
    <Compile Include="$(FixtureTrustSource)" Condition="'$(FixtureTrustSource)' != ''" />
    <Compile Include="../../src/Observability/*.cs" />
  </ItemGroup>
</Project>
